# Market engine (FastAPI) with the Ausgrid panel built in.
# Written for any Docker host; not run on the development machine (no Docker there).
FROM python:3.11-slim

WORKDIR /app
COPY ml/requirements.txt ml/requirements.txt
COPY sim/requirements.txt sim/requirements.txt
RUN pip install --no-cache-dir -r sim/requirements.txt

COPY config config
COPY ml ml
COPY market market
COPY sim sim
COPY contracts/deployments contracts/deployments

# Build the data panel at image build time (downloads ~57 MB, calls Open-Meteo for 17 cells).
RUN python -m ml.data
# Forecasts are optional: without them agents fall back to the seasonal-naive rule.
COPY deploy/forecasts/ data/processed/

ENV LEM_PORT=8000 LEM_CHAIN=0
EXPOSE 8000
CMD ["python", "-c", "import uvicorn; uvicorn.run('sim.api:app', host='0.0.0.0', port=8000)"]
